[req]
prompt = no
distinguished_name = dn
req_extensions = v3_req

[dn]
CN = {{ cert_common_name }}

[v3_req]
subjectAltName = @alt_names
keyUsage = critical, digitalSignature, keyEncipherment
extendedKeyUsage = {{ cert_extended_usage }}

[alt_names]
{% for san in cert_sans %}
{% if san is match('^[0-9.]+$') %}
IP.{{ loop.index }} = {{ san }}
{% else %}
DNS.{{ loop.index }} = {{ san }}
{% endif %}
{% endfor %}