{
  "uid": "k8s-events",
  "title": "Kubernetes Events",
  "tags": ["kubernetes", "events"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Pod Events by Reason",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "expr": "sum by (reason) (event_exporter_pod_event_count)",
          "legendFormat": "{{reason}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Pod Events by Namespace",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "expr": "sum by (exported_namespace) (event_exporter_pod_event_count)",
          "legendFormat": "{{exported_namespace}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Pod Events Details",
      "type": "table",
      "gridPos": {"h": 9, "w": 24, "x": 0, "y": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "expr": "event_exporter_pod_event_count",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "__name__": true,
              "container": true,
              "endpoint": true,
              "instance": true,
              "job": true,
              "namespace": true,
              "pod": true,
              "service": true
            },
            "renameByName": {
              "exported_namespace": "Namespace",
              "exported_pod": "Pod",
              "reason": "Reason",
              "Value": "Events"
            }
          }
        }
      ]
    },
    {
      "id": 4,
      "title": "Event Exporter Health",
      "type": "stat",
      "gridPos": {"h": 7, "w": 24, "x": 0, "y": 17},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "expr": "event_exporter_events_sent",
          "legendFormat": "Events sent",
          "refId": "A"
        },
        {
          "expr": "event_exporter_events_discarded",
          "legendFormat": "Events discarded",
          "refId": "B"
        },
        {
          "expr": "event_exporter_send_event_errors",
          "legendFormat": "Send errors",
          "refId": "C"
        },
        {
          "expr": "event_exporter_watch_errors",
          "legendFormat": "Watch errors",
          "refId": "D"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      }
    }
  ]
}
